page {
  min-height: 100vh;
  background: #ffffff;
  color: #111111;
}

.identity-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 72rpx 44rpx;
  background: #ffffff;
  color: #111111;
}

.brand-mark {
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 0.04em;
}

.identity-card {
  padding: 72rpx 0;
}

.welcome-card {
  padding: 72rpx 0 40rpx;
}

.eyebrow {
  margin-bottom: 20rpx;
  color: rgba(17, 17, 17, 0.38);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.28em;
}

.title {
  max-width: 560rpx;
  font-size: 62rpx;
  line-height: 1.03;
  font-weight: 900;
  letter-spacing: -0.04em;
}

.avatar-button {
  width: 176rpx;
  height: 176rpx;
  margin: 48rpx 0 28rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 999rpx;
  background: #f0f0f0;
}

.wechat-profile-button {
  margin: 40rpx 0 0;
  min-height: 84rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.14);
  border-radius: 999rpx;
  background: #ffffff;
  color: #111111;
  font-size: 26rpx;
  font-weight: 800;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
  padding: 18rpx;
  box-sizing: border-box;
  color: rgba(17, 17, 17, 0.48);
  font-size: 22rpx;
  font-weight: 800;
}

.nickname-input {
  min-height: 96rpx;
  padding: 0 32rpx;
  border-radius: 28rpx;
  background: #f5f5f5;
  font-size: 30rpx;
  font-weight: 800;
}

.primary-button {
  margin-top: 40rpx;
  min-height: 104rpx;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.welcome-primary {
  margin-top: 56rpx;
}

.secondary-button {
  margin-top: 20rpx;
  min-height: 96rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.14);
  border-radius: 999rpx;
  background: #ffffff;
  color: #111111;
  font-size: 28rpx;
  font-weight: 900;
}

.privacy-copy {
  margin: 28rpx auto 0;
  max-width: 560rpx;
  color: rgba(17, 17, 17, 0.48);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.7;
  text-align: center;
}

.welcome-scene {
  position: relative;
  width: 360rpx;
  height: 260rpx;
  margin: 64rpx auto 0;
}

.welcome-orbit {
  position: absolute;
  inset: 10rpx 30rpx 20rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.1);
  border-radius: 50%;
}

.welcome-bowl {
  position: absolute;
  left: 80rpx;
  right: 80rpx;
  bottom: 36rpx;
  height: 92rpx;
  border: 10rpx solid #111111;
  border-top-width: 4rpx;
  border-radius: 20rpx 20rpx 120rpx 120rpx;
  background: #ffffff;
  transform: perspective(240rpx) rotateX(-8deg);
}

.welcome-steam {
  position: absolute;
  top: 48rpx;
  width: 52rpx;
  height: 88rpx;
  border-left: 7rpx solid #111111;
  border-radius: 50%;
  opacity: 0.82;
}

.welcome-steam-left {
  left: 140rpx;
  transform: rotate(10deg);
}

.welcome-steam-right {
  right: 118rpx;
  transform: rotate(-12deg);
}

.primary-button[disabled] {
  opacity: 0.48;
}

.error-text {
  margin-top: 24rpx;
  color: #4e4e4e;
  font-size: 24rpx;
  font-weight: 700;
}
