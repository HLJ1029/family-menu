<page-state status="{{status}}" error-text="{{errorText}}" bind:retry="retry">
  <view class="native-tab">
    <text class="eyebrow">{{householdName}}</text>
    <text class="native-tab-title">这周怎么吃</text>
    <text class="native-tab-copy">{{canEditMenu ? "你可以调整晚餐；早餐和午餐先保留兼容查看。" : "家庭创建者负责调整菜单，你可以随时查看。"}}</text>
    <view wx:if="{{status === 'cached'}}" class="notice">正在显示离线缓存；联网后才能修改菜单。</view>
    <view wx:if="{{conflictVisible}}" class="notice conflict">家人刚更新了安排，下面已是最新版本。</view>
    <view wx:if="{{errorText && status !== 'error'}}" class="notice conflict">{{errorText}}</view>
    <meal-day
      wx:for="{{days}}"
      wx:key="dateKey"
      day="{{item}}"
      can-edit="{{menuEditAvailable}}"
      busy="{{pendingAction !== ''}}"
      bind:choose="openRecipeChooser"
    />
  </view>

  <view wx:if="{{chooserVisible}}" class="chooser-backdrop" bindtap="closeRecipeChooser"></view>
  <view wx:if="{{chooserVisible}}" class="recipe-chooser">
    <view class="chooser-heading">
      <view>
        <text class="eyebrow">{{chooserDateLabel}}晚餐</text>
        <text class="chooser-title">选择要做的菜</text>
      </view>
      <text class="chooser-close" bindtap="closeRecipeChooser">关闭</text>
    </view>
    <text class="chooser-copy">可多选；保存空选择就是移除这天晚餐。</text>
    <scroll-view class="recipe-scroll" scroll-y>
      <view
        wx:for="{{recipeChoices}}"
        wx:key="recipeId"
        class="recipe-choice {{item.selected ? 'selected' : ''}}"
        data-recipe-id="{{item.recipeId}}"
        bindtap="toggleRecipe"
      >
        <view>
          <text class="recipe-title">{{item.title}}</text>
          <text class="recipe-meta">{{item.minutes}} 分钟 · {{item.effortLabel}}</text>
        </view>
        <text class="recipe-check">{{item.selected ? '已选' : '选择'}}</text>
      </view>
    </scroll-view>
    <view class="chooser-actions">
      <button class="clear-button" disabled="{{!!pendingAction}}" bindtap="clearRecipeSelection">清空晚餐</button>
      <button class="save-button" loading="{{pendingAction === 'replace_dinner'}}" disabled="{{!!pendingAction}}" bindtap="saveRecipeSelection">保存安排</button>
    </view>
  </view>
</page-state>
