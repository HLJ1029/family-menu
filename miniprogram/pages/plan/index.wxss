.native-tab { padding: 40rpx 28rpx 160rpx; }
.eyebrow { display: block; color: #777; font-size: 24rpx; font-weight: 700; }
.native-tab-title { display: block; margin-top: 8rpx; color: #111; font-size: 48rpx; font-weight: 800; }
.native-tab-copy { display: block; margin: 16rpx 0 30rpx; color: #666; font-size: 27rpx; line-height: 1.6; }
.notice { margin-bottom: 24rpx; padding: 20rpx 24rpx; border-radius: 20rpx; background: #f2f2f2; color: #555; font-size: 24rpx; }
.conflict { background: #fff0dc; color: #75450a; }
.chooser-backdrop { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 20; background: rgba(0, 0, 0, .36); }
.recipe-chooser { position: fixed; right: 0; bottom: 0; left: 0; z-index: 21; padding: 30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #fff; }
.chooser-heading { display: flex; align-items: flex-start; justify-content: space-between; }
.chooser-title { display: block; margin-top: 6rpx; color: #111; font-size: 38rpx; font-weight: 800; }
.chooser-close { padding: 8rpx 0 8rpx 24rpx; color: #666; font-size: 25rpx; }
.chooser-copy { display: block; margin: 14rpx 0 20rpx; color: #777; font-size: 23rpx; }
.recipe-scroll { height: 620rpx; }
.recipe-choice { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; padding: 22rpx 24rpx; border: 2rpx solid #ececec; border-radius: 22rpx; }
.recipe-choice.selected { border-color: #111; background: #f5f5f5; }
.recipe-title { display: block; color: #111; font-size: 28rpx; font-weight: 750; }
.recipe-meta { display: block; margin-top: 6rpx; color: #777; font-size: 22rpx; }
.recipe-check { color: #555; font-size: 23rpx; font-weight: 700; }
.chooser-actions { display: flex; gap: 16rpx; margin-top: 22rpx; }
.clear-button, .save-button { flex: 1; margin: 0; border-radius: 999rpx; font-size: 27rpx; font-weight: 750; }
.clear-button { background: #f1f1f1; color: #333; }
.save-button { background: #111; color: #fff; }
.clear-button::after, .save-button::after { border: 0; }
