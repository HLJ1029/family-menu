page { min-height: 100vh; background: #f5f5f5; color: #111; }
.activity-page { padding: 42rpx 28rpx 120rpx; }
.heading { padding: 14rpx 8rpx 28rpx; }
.eyebrow { display: block; color: rgba(17,17,17,.42); font-size: 21rpx; font-weight: 900; letter-spacing: .1em; }
.title { display: block; max-width: 620rpx; margin-top: 12rpx; font-size: 50rpx; line-height: 1.16; font-weight: 900; letter-spacing: -.04em; }
.copy { display: block; margin-top: 16rpx; color: rgba(17,17,17,.58); font-size: 24rpx; line-height: 1.65; font-weight: 700; }
.activity-card { padding: 12rpx 30rpx 24rpx; border: 2rpx solid rgba(17,17,17,.08); border-radius: 32rpx; background: #fff; }
.empty { padding: 56rpx 18rpx; text-align: center; }
.empty-title { display: block; font-size: 30rpx; font-weight: 900; }
.empty-copy { display: block; margin-top: 12rpx; color: rgba(17,17,17,.54); font-size: 23rpx; line-height: 1.6; font-weight: 700; }
.back-button { min-height: 90rpx; margin: 24rpx 0 0; border: 2rpx solid rgba(17,17,17,.12); border-radius: 999rpx; background: #fff; color: #111; font-size: 25rpx; font-weight: 900; }
