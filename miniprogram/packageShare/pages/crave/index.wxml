<page-state status="{{status}}" error-text="{{errorText}}" bind:retry="retry">
  <view class="crave-page">
    <view class="heading">
      <text class="eyebrow">{{request.initiatorName || '家人'}}发来的口味征集</text>
      <text class="title">今晚想吃什么感觉？</text>
      <text class="copy">不用登录，也不用先想出菜名。点一个感觉，Humi 就会记为游客回复；已经登录时会自动使用你的 Humi 身份。</text>
    </view>

    <view wx:if="{{request.status !== 'open'}}" class="result-card">
      <text class="result-title">这次征集已经结束</text>
      <text class="result-copy">{{request.initiatorName || '家人'}}已经开始安排今晚菜单，晚一点看到也没关系。</text>
      <button class="primary-button" bindtap="goHome">回到 Humi</button>
    </view>

    <view wx:elif="{{submitted}}" class="result-card">
      <text class="result-kicker">已收到</text>
      <text class="result-title">{{participant.displayName || '这次回复'}} · {{selectedFeeling}}</text>
      <text class="result-copy">家人会在 Humi 的协作记录里看到。你可以直接关掉页面，不需要再补资料。</text>
      <button class="primary-button" open-type="share">也问问另一位家人</button>
      <button class="secondary-button" bindtap="goHome">回到 Humi</button>
    </view>

    <form wx:else bindsubmit="submitVote">
      <view class="feeling-card">
        <text class="card-label">点一个最接近的</text>
        <view class="feeling-grid">
          <button
            wx:for="{{feelings}}"
            wx:key="*this"
            class="feeling-button {{selectedFeeling === item ? 'selected' : ''}}"
            type="button"
            data-feeling="{{item}}"
            bindtap="selectFeeling"
            disabled="{{!!pendingAction}}"
          >{{item}}</button>
        </view>
      </view>

      <view class="detail-card">
        <button class="detail-toggle" type="button" bindtap="toggleDetails">想补一句？选填</button>
        <view wx:if="{{detailsOpen}}" class="detail-fields">
          <input class="detail-input" value="{{dishWish}}" maxlength="80" placeholder="有特别想吃的菜？" bindinput="updateDishWish" />
          <input class="detail-input" value="{{note}}" maxlength="80" placeholder="比如：别太辣、想快一点" bindinput="updateNote" />
        </view>
      </view>

      <text wx:if="{{errorText}}" class="inline-error">{{errorText}}</text>
      <button class="primary-button" form-type="submit" loading="{{pendingAction === 'submit'}}" disabled="{{!!pendingAction}}">发给家人</button>
    </form>
  </view>
</page-state>
