page { min-height: 100vh; background: #f5f5f5; color: #111; }
.crave-page { padding: 42rpx 28rpx 120rpx; }
.heading { padding: 14rpx 8rpx 28rpx; }
.eyebrow,.card-label,.result-kicker { display: block; color: rgba(17,17,17,.44); font-size: 21rpx; font-weight: 900; letter-spacing: .08em; }
.title { display: block; max-width: 620rpx; margin-top: 14rpx; font-size: 52rpx; line-height: 1.14; font-weight: 900; letter-spacing: -.04em; }
.copy { display: block; margin-top: 16rpx; color: rgba(17,17,17,.58); font-size: 25rpx; line-height: 1.65; font-weight: 700; }
.feeling-card,.detail-card,.result-card { margin-top: 22rpx; padding: 30rpx; border: 2rpx solid rgba(17,17,17,.08); border-radius: 32rpx; background: #fff; }
.feeling-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 22rpx; }
.feeling-button { min-height: 82rpx; margin: 0; padding: 0 14rpx; border: 2rpx solid rgba(17,17,17,.1); border-radius: 999rpx; background: #f5f5f5; color: #111; font-size: 23rpx; font-weight: 900; }
.feeling-button.selected { border-color: #111; background: #111; color: #fff; }
.detail-toggle { min-height: 70rpx; margin: 0; padding: 0; background: transparent; color: #111; font-size: 24rpx; font-weight: 900; text-align: left; }
.detail-fields { display: grid; gap: 16rpx; margin-top: 18rpx; }
.detail-input { min-height: 88rpx; padding: 0 24rpx; border-radius: 22rpx; background: #f5f5f5; font-size: 24rpx; font-weight: 700; }
.primary-button,.secondary-button { min-height: 94rpx; margin: 26rpx 0 0; border-radius: 999rpx; font-size: 26rpx; font-weight: 900; }
.primary-button { background: #111; color: #fff; }
.secondary-button { border: 2rpx solid rgba(17,17,17,.12); background: #fff; color: #111; }
.result-title { display: block; margin-top: 12rpx; font-size: 38rpx; line-height: 1.3; font-weight: 900; }
.result-copy { display: block; margin-top: 14rpx; color: rgba(17,17,17,.58); font-size: 24rpx; line-height: 1.6; font-weight: 700; }
.inline-error { display: block; margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: 20rpx; background: #e8e8e8; color: #454545; font-size: 22rpx; line-height: 1.5; font-weight: 800; }
